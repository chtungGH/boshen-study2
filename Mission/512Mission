                <div id="picker-btn-row-${m.id}" class="btn-split-row">
                  <button class="btn btn-primary" onclick="document.getElementById('file-cam-${m.id}').click()">📸 現場拍照</button>
                  <button class="btn btn-secondary" onclick="document.getElementById('file-lib-${m.id}').click()">🖼️ 相簿選圖</button>
                </div>
              </div>`;
          } else if (m.type === "COOP") {
            const matchedAlly = matchedCoopTeams[m.id];
            actionHtml = `
              <div class="action-box">
                <div class="error-msg-banner" id="err-${m.id}"></div>
                
                <div id="qr-reader-box">
                  <div id="qr-reader" style="width: 100%;"></div>
                  <button class="btn btn-secondary" onclick="stopQrScanner()" style="margin-top: 6px;">關閉掃描鏡頭</button>
                </div>

                ${matchedAlly ? `
                  <div class="coop-matched-box">
                    🤝 已成功與【${matchedAlly.name} ${matchedAlly.badge}】完成特務連線！
