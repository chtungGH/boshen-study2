                    <button class="btn btn-secondary" onclick="resetPicker('${m.id}')">🔄 重新選擇</button>
                    <button class="btn btn-primary" id="btn-confirm-${m.id}" onclick="confirmPhotoUpload('${m.id}', ${m.score})">🚀 確認無誤，送出！</button>
