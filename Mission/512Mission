<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>敦小512特務大作戰 - 任務終端機</title>
  
  <!-- 引入 QR Code 產生庫與相機掃描庫 -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>

  <style>
    :root {
      --primary: #10b981;
      --primary-dark: #059669;
      --accent: #f59e0b;
      --danger: #ef4444;
      --bg: #0f172a;
      --surface: #1e293b;
      --surface-light: #334155;
      --text: #f8fafc;
      --text-muted: #94a3b8;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; -webkit-tap-highlight-color: transparent; }
    body { background-color: var(--bg); color: var(--text); padding-bottom: 80px; min-height: 100vh; overflow-x: hidden; }

    /* 頂部導航 */
    header {
      position: sticky; top: 0; z-index: 100;
      background: rgba(30, 41, 59, 0.95);
      backdrop-filter: blur(10px);
      border-bottom: 2px solid var(--surface-light);
      padding: 10px 14px;
      display: flex; justify-content: space-between; align-items: center;
    }
    .team-badge-wrap { display: flex; align-items: center; gap: 8px; }
    .team-avatar { font-size: 1.8rem; background: var(--surface-light); border-radius: 50%; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; }
    .team-title { font-size: 1rem; font-weight: 800; color: #fff; }
    .team-meta { font-size: 0.75rem; color: var(--text-muted); }
    
    /* 頂部常駐按鈕（出示 QR 與總分採統一膠囊單行樣式） */
    .top-actions-wrap { display: flex; align-items: center; gap: 8px; }
    .top-qr-btn {
      background: #0284c7; color: #fff; border: none; border-radius: 8px;
      padding: 6px 10px; font-size: 0.75rem; font-weight: 800; cursor: pointer;
      display: flex; align-items: center; gap: 4px; box-shadow: 0 2px 8px rgba(2, 132, 199, 0.4);
      white-space: nowrap;
    }
    .top-qr-btn:active { background: #0369a1; }

    .top-score-btn {
      background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; border: none; border-radius: 8px;
      padding: 6px 10px; font-size: 0.75rem; font-weight: 800;
      display: flex; align-items: center; gap: 4px; box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
      white-space: nowrap;
    }
    .top-score-val { font-size: 0.85rem; font-weight: 900; }

    /* 狀態與耗時條 */
    .radar-bar {
      background: #022c22; border-bottom: 1px solid #065f46;
      padding: 8px 16px; font-size: 0.78rem; color: #6ee7b7;
      display: flex; justify-content: space-between; align-items: center;
    }
    .timer-badge { font-weight: 800; color: #fef08a; letter-spacing: 0.5px; }

    .container { max-width: 500px; margin: 0 auto; padding: 16px; }

    /* 任務卡片 */
    .mission-card {
      background: var(--surface);
      border: 1px solid var(--surface-light);
      border-radius: 16px;
      padding: 18px;
      margin-bottom: 16px;
      position: relative;
      transition: all 0.25s;
    }
    .mission-card.completed {
      border-color: #059669;
      background: linear-gradient(180deg, rgba(6,78,59,0.25) 0%, var(--surface) 100%);
    }
    .mission-card.skipped {
      border-color: #475569;
      background: rgba(30, 41, 59, 0.4);
      opacity: 0.75;
    }
    .card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .tag-group { display: flex; align-items: center; gap: 6px; }
    .category-tag { font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; background: var(--surface-light); color: #38bdf8; }
    .score-tag { font-size: 0.85rem; font-weight: 800; color: var(--accent); background: rgba(245, 158, 11, 0.1); padding: 4px 8px; border-radius: 6px; }
    .skip-btn-text { background: transparent; border: none; color: #94a3b8; font-size: 0.8rem; cursor: pointer; padding: 4px 6px; border-radius: 4px; }
    .skip-btn-text:active { color: #f87171; }

    .mission-title { font-size: 1.15rem; font-weight: 800; margin-bottom: 6px; color: #fff; }
    .mission-desc { font-size: 0.9rem; color: #cbd5e1; line-height: 1.45; margin-bottom: 14px; }

    /* 通關與放棄區塊 */
    .completed-proof-box {
      margin-top: 12px; border-radius: 12px; background: rgba(0,0,0,0.3);
      padding: 12px; border: 1px dashed #059669; text-align: center;
    }
    .skipped-box {
      margin-top: 12px; border-radius: 12px; background: rgba(0,0,0,0.2);
      padding: 12px; border: 1px dashed #64748b; text-align: center;
    }
    .completed-thumb { width: 100%; max-height: 200px; object-fit: cover; border-radius: 8px; margin-top: 8px; }

    /* 操作互動區 */
    .action-box { background: rgba(0,0,0,0.25); border-radius: 12px; padding: 14px; margin-top: 10px; }
    .btn {
      display: block; width: 100%; padding: 12px; border-radius: 10px;
      border: none; font-size: 0.95rem; font-weight: 700; cursor: pointer;
      text-align: center; transition: all 0.2s;
    }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-primary:active { background: var(--primary-dark); }
    .btn-secondary { background: var(--surface-light); color: #fff; }
    .btn-accent { background: #0284c7; color: #fff; }
    .btn-gold { background: linear-gradient(135deg, #f59e0b, #d97706); color: #fff; box-shadow: 0 4px 15px rgba(245, 158, 11, 0.4); }
    .btn-outline-gold { background: transparent; border: 2px solid var(--accent); color: var(--accent); font-weight: 800; }
    .btn-danger-outline { background: transparent; border: 1px dashed #ef4444; color: #ef4444; font-size: 0.8rem; padding: 8px; margin-top: 24px; }
    .btn-split-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 6px; }

    /* 暗號輸入框與錯誤回饋 */
    .input-code {
      width: 100%; padding: 12px; border-radius: 8px; border: 2px solid var(--surface-light);
      background: #0f172a; color: #fff; font-size: 1.15rem; text-align: center;
      margin-bottom: 8px; letter-spacing: 2px;
    }
    .input-code.error {
      border-color: var(--danger) !important;
      animation: shake 0.3s ease-in-out;
    }
    .error-msg-banner {
      background: rgba(239, 68, 68, 0.2); border: 1px solid var(--danger);
      color: #fca5a5; padding: 8px 12px; border-radius: 8px; font-size: 0.85rem;
      font-weight: bold; margin-bottom: 10px; text-align: center; display: none;
    }
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-8px); }
      40%, 80% { transform: translateX(8px); }
    }

    /* 拍照預覽容器 */
    .preview-container { margin-bottom: 12px; text-align: center; display: none; }
    .preview-container img { width: 100%; max-height: 200px; object-fit: cover; border-radius: 10px; border: 2px solid var(--accent); }
    .btn-group { display: flex; gap: 8px; margin-top: 8px; }

    /* 全螢幕相片加密壓縮提示遮罩 */
    .processing-overlay {
      position: fixed; inset: 0; background: rgba(15, 23, 42, 0.92);
      backdrop-filter: blur(8px); z-index: 9999; display: none;
      flex-direction: column; align-items: center; justify-content: center;
    }
    .spinner {
      width: 52px; height: 52px; border: 5px solid rgba(255, 255, 255, 0.15);
      border-top-color: var(--primary); border-radius: 50%;
      animation: spin 0.8s linear infinite; margin-bottom: 18px;
    }
    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* 模態彈窗 */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.88); backdrop-filter: blur(8px);
      z-index: 999; display: flex; align-items: center; justify-content: center; padding: 20px;
    }
    .modal-box {
      background: var(--surface); border: 1px solid var(--surface-light);
      width: 100%; max-width: 420px; border-radius: 20px; padding: 24px;
      max-height: 90vh; overflow-y: auto; text-align: center;
    }
    .modal-title { font-size: 1.35rem; font-weight: 900; margin-bottom: 16px; color: var(--accent); }
    .form-group { margin-bottom: 14px; text-align: left; }
    .form-label { display: block; font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px; font-weight: 600; }
    .form-select, .form-input {
      width: 100%; padding: 12px; border-radius: 8px; background: #0f172a;
      border: 1px solid var(--surface-light); color: #fff; font-size: 1rem;
    }
    .badge-picker { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin-top: 6px; }
    .badge-opt { font-size: 1.7rem; padding: 8px; border-radius: 8px; background: #0f172a; border: 1px solid var(--surface-light); text-align: center; cursor: pointer; }
    .badge-opt.selected { border-color: var(--primary); background: rgba(16, 185, 129, 0.2); }

    /* QR Code 展示容器 */
    #qrcode-display {
      display: flex; justify-content: center; align-items: center;
      background: #fff; padding: 16px; border-radius: 12px; margin: 16px auto;
      width: 220px; height: 220px; min-height: 220px;
    }
    #qrcode-display img, #qrcode-display canvas {
      display: block; margin: 0 auto; max-width: 100%; max-height: 100%;
    }
    #qr-reader-box { width: 100%; border-radius: 12px; overflow: hidden; margin-bottom: 12px; display: none; background: #000; }

    .coop-matched-box {
      background: rgba(16, 185, 129, 0.15); border: 2px solid var(--primary);
      padding: 12px; border-radius: 10px; margin-bottom: 12px; font-weight: 800; color: #6ee7b7;
    }

    /* 證書樣式 */
    .cert-card {
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border: 3px solid var(--accent); border-radius: 16px; padding: 20px; text-align: center; margin-bottom: 16px;
    }
    .cert-photo-wrap {
      width: 100%; height: 180px; border-radius: 10px; background: #000;
      overflow: hidden; margin: 12px 0; border: 2px dashed #94a3b8;
      display: flex; align-items: center; justify-content: center;
    }
    .cert-photo-wrap img { width: 100%; height: 100%; object-fit: cover; }

    #confetti-canvas {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      pointer-events: none; z-index: 1000; display: none;
    }
    #all-done-banner {
      display: none; padding: 14px 16px; background: linear-gradient(90deg, #064e3b, #0f766e);
      border-bottom: 3px solid #34d399; text-align: center; position: sticky; top: 68px; z-index: 90;
    }
  </style>
</head>
<body>

  <!-- 全螢幕相片加密壓縮提示遮罩 -->
  <div class="processing-overlay" id="loading-overlay">
    <div class="spinner"></div>
    <div style="font-size: 1.15rem; font-weight: 800; color: #fff;" id="loading-title">📸 特務相片加密壓縮中...</div>
    <div style="font-size: 0.8rem; color: #94a3b8; margin-top: 6px;">請稍候，正在產生通關存證縮圖</div>
  </div>

  <canvas id="confetti-canvas"></canvas>

  <!-- 頂部資訊列 (出示 QR 與總分採統一單行膠囊樣式) -->
  <header>
    <div class="team-badge-wrap">
      <div class="team-avatar" id="disp-badge">🦅</div>
      <div>
        <div class="team-title" id="disp-team-name">連線準備中</div>
        <div class="team-meta" id="disp-team-id">ID: ----</div>
      </div>
    </div>
    
    <div class="top-actions-wrap">
      <button class="top-qr-btn" onclick="showMyQrCode()">📱 出示QR</button>
      <div class="top-score-btn">
        <span>🏆 積分:</span>
        <span class="top-score-val" id="disp-score">0</span>
      </div>
    </div>
  </header>

  <!-- 狀態條 -->
  <div class="radar-bar">
    <div class="timer-badge" id="disp-timer">⏱️ 任務耗時: 00:00:00</div>
    <div id="disp-progress">進度: 0/0</div>
  </div>

  <!-- 全滿貫成就大橫幅 -->
  <div id="all-done-banner">
    <button class="btn btn-gold" onclick="openCertModal()" style="font-size: 1.05rem; padding: 14px;">
      🏆 恭喜全滿貫通關！點此領取特務榮譽勳章 🏆
    </button>
  </div>

  <!-- 任務清單容器 -->
  <div class="container" id="mission-list">
    <div style="text-align: center; padding: 40px; color: var(--text-muted);">
      📡 正在從總部載入任務...
    </div>
  </div>

  <!-- 提前結業領證按鈕區 -->
  <div style="max-width: 500px; margin: 0 auto; padding: 0 16px 12px 16px;">
    <button class="btn btn-outline-gold" onclick="openCertModal()" style="padding: 14px;">
      🏁 時間差不多了？以現有成績申請結業證書！
    </button>
  </div>

  <!-- 測試用重來入口 -->
  <div style="max-width: 500px; margin: 0 auto; padding: 0 16px 20px 16px; text-align: center;">
    <button class="btn btn-danger-outline" onclick="resetLocalProgress()">
      重置本機所有任務進度並重新開始
    </button>
  </div>

  <!-- 註冊彈窗 (10 組小隊 ＆ 10 款指定 Emoji) -->
  <div class="modal-overlay" id="reg-modal" style="display: none;">
    <div class="modal-box">
      <div class="modal-title">🎖️ 特務小隊出發認證</div>
      
      <div class="form-group">
        <label class="form-label">選擇所屬小隊（共 10 組）</label>
        <select class="form-select" id="reg-team-id">
          <option value="T01">第 1 組 (T01)</option>
          <option value="T02">第 2 組 (T02)</option>
          <option value="T03">第 3 組 (T03)</option>
          <option value="T04">第 4 組 (T04)</option>
          <option value="T05">第 5 組 (T05)</option>
          <option value="T06">第 6 組 (T06)</option>
          <option value="T07">第 7 組 (T07)</option>
          <option value="T08">第 8 組 (T08)</option>
          <option value="T09">第 9 組 (T09)</option>
          <option value="T10">第 10 組 (T10)</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">小隊自訂名稱</label>
        <input type="text" class="form-input" id="reg-team-name" placeholder="例如：音速狂狼隊" maxlength="8">
      </div>

      <div class="form-group">
        <label class="form-label">挑選小隊代表隊徽</label>
        <div class="badge-picker" id="badge-picker">
          <div class="badge-opt selected">🐘</div>
          <div class="badge-opt">🐯</div>
          <div class="badge-opt">🐰</div>
          <div class="badge-opt">🐱</div>
          <div class="badge-opt">🐶</div>
          <div class="badge-opt">🦚</div>
          <div class="badge-opt">🦄</div>
          <div class="badge-opt">🦋</div>
          <div class="badge-opt">🐞</div>
          <div class="badge-opt">🐹</div>
        </div>
      </div>

      <button class="btn btn-primary" onclick="submitRegistration()" style="margin-top: 14px;">
        🚀 確認隊名，連線出發！
      </button>
    </div>
  </div>

  <!-- QR Code 彈窗 (保證 100% 正常開啟) -->
  <div class="modal-overlay" id="qr-modal" style="display: none;">
    <div class="modal-box">
      <div class="modal-title">📡 本小隊特務連線碼</div>
      <p style="font-size: 0.85rem; color: var(--text-muted);">請將此螢幕出示給另一組特務掃描</p>
      
      <!-- QR Code 畫布 -->
      <div id="qrcode-display"></div>
      
      <div id="qr-team-summary" style="font-weight: 800; font-size: 1.15rem; color: #fff; margin-bottom: 14px;"></div>
      <button class="btn btn-secondary" onclick="closeQrModal()">關閉返回</button>
    </div>
  </div>

  <!-- 榮譽結業證書彈窗 -->
  <div class="modal-overlay" id="cert-modal" style="display: none;">
    <div class="modal-box">
      <div class="cert-card" id="cert-area">
        <div style="font-size: 2.6rem;" id="cert-badge">🏆</div>
        <h2 style="color: var(--accent); margin: 8px 0; font-size: 1.3rem;" id="cert-title-text">特務榮譽結業證書</h2>
        <div style="font-size: 1.15rem; font-weight: bold; color: #fff;" id="cert-team-title">音速狂狼隊</div>
        
        <p style="font-size: 0.85rem; color: #cbd5e1; margin: 6px 0 10px 0; line-height: 1.4;" id="cert-cheer-text">
          在 512 戶外特務大作戰中全力以赴，展現了無與倫比的勇氣與團隊默契！
        </p>
        
        <div class="cert-photo-wrap">
          <span style="color: #64748b; font-size: 0.85rem;" id="cert-photo-placeholder">點擊下方拍照新增結業合影</span>
          <img id="cert-img" style="display: none;">
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 4px; margin-top: 12px; background: rgba(0,0,0,0.3); padding: 8px; border-radius: 8px;">
          <div><div style="font-size:0.7rem; color:#94a3b8;">最終總積分</div><div style="font-size:1.1rem; font-weight:900; color:var(--accent);" id="cert-score">0</div></div>
          <div><div style="font-size:0.7rem; color:#94a3b8;">達成進度</div><div style="font-size:1.05rem; font-weight:900; color:#34d399;" id="cert-tasks">0/0</div></div>
          <div><div style="font-size:0.7rem; color:#94a3b8;">總耗時</div><div style="font-size:0.95rem; font-weight:900; color:#fef08a;" id="cert-duration">--:--</div></div>
        </div>
      </div>

      <input type="file" id="cert-photo-input" accept="image/*" capture="environment" style="display: none;" onchange="handleCertPhoto(event)">
      <button class="btn btn-primary" onclick="document.getElementById('cert-photo-input').click()">📸 拍張小隊結業大合照</button>
      <button class="btn btn-secondary" onclick="window.print()" style="margin-top: 8px;">🖨️ 列印 / 截圖保存此證書</button>
      <button class="btn btn-secondary" onclick="document.getElementById('cert-modal').style.display='none'" style="margin-top: 8px;">返回繼續挑戰</button>
    </div>
  </div>

  <script>
    // ==================== 1. 核心參數與題庫 ====================
    const GAS_API_URL = "https://script.google.com/macros/s/AKfycbx-Fbw-uYiMSv9t17C-K49JPQts8fMFRVr2N2pFRFRO5OtrVQMMa9SNoQzu3KhHEwl93A/exec";

    const FALLBACK_MISSIONS = [
      { id: "M01", category: "現場解謎", title: "公園時光之碑", desc: "找到園區最具代表性的紀事石碑或平面圖，輸入上面記載的建立年份四碼密碼！", score: 100, type: "CODE", passcode: "1998" },
      { id: "M02", category: "現場解謎", title: "階梯密碼算術師", desc: "前往中央大涼亭，數出【主要階梯數】加上【涼亭柱子數】的總和數字輸入解鎖！", score: 100, type: "CODE", passcode: "24" },
      { id: "M03", category: "搞怪錯位", title: "巨人的下午茶", desc: "近大遠小！一名隊員在近處張大嘴，另一名隊員在遠處，拍一張掉進嘴裡的搞笑瞬間！", score: 150, type: "PHOTO", passcode: "" },
      { id: "M04", category: "搞怪錯位", title: "單手捏爆建築物", desc: "隊長在前景伸出兩指，精準借位捏住遠處的涼亭頂部，隊員全體做出崇拜表情！", score: 150, type: "PHOTO", passcode: "" },
      { id: "M05", category: "動態抓拍", title: "地心引力消失瞬間", desc: "全隊隊員同時原地跳起，攝影官抓拍一張全員雙腳同時離地懸空的瞬間！", score: 150, type: "PHOTO", passcode: "" },
      { id: "M06", category: "生態獵人", title: "大自然天然色票", desc: "在地上撿拾落葉排成【綠 ➔ 黃 ➔ 紅 ➔ 褐】由淺到深的漸層色階並俯拍特寫！", score: 100, type: "PHOTO", passcode: "" },
      { id: "M07", category: "環境守護", title: "綠色特務的使命", desc: "全隊合力在活動範圍內撿起3個非自然垃圾，拍下全員投入垃圾桶的瞬間！", score: 100, type: "PHOTO", passcode: "" },
      { id: "M08", category: "家長互動", title: "神秘接頭人密電", desc: "找到在野餐區戴帽子的家長關主，說出暗號【今天的麻雀穿雨鞋嗎？】獲得通關碼！", score: 150, type: "CODE", passcode: "777" },
      { id: "M09", category: "跨組合作", title: "雙隊合體：八星連珠", desc: "找到另一組小隊（或落單時回總部找大會裁判）！出示或掃描特務連線碼，並拍下全員結盟合影！", score: 200, type: "COOP", passcode: "" }
    ];

    let currentTeam = { id: "", name: "", badge: "🦅" };
    let activeMissions = [];
    let completedMissionIds = new Set();
    let skippedMissionIds = new Set();
    let missionPhotos = {};
    let matchedCoopTeams = {};
    let currentScore = 0;
    let tempPhotos = {};
    let startTime = null;
    let timerInterval = null;
    let wakeLock = null;
    let awayStartTime = null;
    let html5QrScanner = null;

    // ==================== 2. 初始化 ====================
    window.addEventListener("DOMContentLoaded", async () => {
      loadLocalProfile();
      setupBadgePicker();
      setupWakeLock();
      setupVisibilityMonitor();

      if (!currentTeam.id) {
        await checkTakenTeams();
        document.getElementById("reg-modal").style.display = "flex";
      } else {
        updateTeamHeader();
        startTimer();
        fetchMissions();
      }

      setInterval(() => {
        if (currentTeam.id) sendHeartbeat("active");
      }, 15000);
    });

    function loadLocalProfile() {
      const saved = localStorage.getItem("team_profile");
      if (saved) currentTeam = JSON.parse(saved);

      const savedDone = localStorage.getItem("completed_missions");
      if (savedDone) completedMissionIds = new Set(JSON.parse(savedDone));

      const savedSkipped = localStorage.getItem("skipped_missions");
      if (savedSkipped) skippedMissionIds = new Set(JSON.parse(savedSkipped));

      const savedScore = localStorage.getItem("current_score");
      if (savedScore) currentScore = Number(savedScore);

      const savedPhotos = localStorage.getItem("mission_photos");
      if (savedPhotos) missionPhotos = JSON.parse(savedPhotos);

      const savedCoop = localStorage.getItem("matched_coop_teams");
      if (savedCoop) matchedCoopTeams = JSON.parse(savedCoop);

      const savedStart = localStorage.getItem("start_time");
      if (savedStart) startTime = Number(savedStart);

      const savedCertImg = localStorage.getItem("cert_img");
      if (savedCertImg) {
        const cImg = document.getElementById("cert-img");
        cImg.src = savedCertImg;
        cImg.style.display = "block";
        document.getElementById("cert-photo-placeholder").style.display = "none";
      }
    }

    function startTimer() {
      if (!startTime) {
        startTime = new Date().getTime();
        localStorage.setItem("start_time", startTime);
      }

      if (timerInterval) clearInterval(timerInterval);
      timerInterval = setInterval(() => {
        const now = new Date().getTime();
        const diffSec = Math.floor((now - startTime) / 1000);
        const hrs = String(Math.floor(diffSec / 3600)).padStart(2, '0');
        const mins = String(Math.floor((diffSec % 3600) / 60)).padStart(2, '0');
        const secs = String(diffSec % 60).padStart(2, '0');
        document.getElementById("disp-timer").innerText = `⏱️ 任務耗時: ${hrs}:${mins}:${secs}`;
      }, 1000);
    }

    async function checkTakenTeams() {
      if (!GAS_API_URL) return;
      try {
        const res = await fetch(`${GAS_API_URL}?action=GET_DASHBOARD`);
        const data = await res.json();
        if (data && data.teams) {
          const selectEl = document.getElementById("reg-team-id");
          data.teams.forEach(t => {
            if (t.status !== "Offline") {
              const opt = selectEl.querySelector(`option[value="${t.teamId}"]`);
              if (opt) {
                opt.disabled = true;
                opt.innerText += " (已被選取)";
              }
            }
          });
        }
      } catch (e) {}
    }

    function setupBadgePicker() {
      const opts = document.querySelectorAll(".badge-opt");
      opts.forEach(el => {
        el.addEventListener("click", () => {
          opts.forEach(o => o.classList.remove("selected"));
          el.classList.add("selected");
        });
      });
    }

    function submitRegistration() {
      const teamId = document.getElementById("reg-team-id").value;
      const teamName = document.getElementById("reg-team-name").value.trim() || `${teamId}小隊`;
      const selectedBadgeEl = document.querySelector(".badge-opt.selected");
      const badge = selectedBadgeEl ? selectedBadgeEl.innerText : "🦅";

      currentTeam = { id: teamId, name: teamName, badge: badge };
      localStorage.setItem("team_profile", JSON.stringify(currentTeam));

      document.getElementById("reg-modal").style.display = "none";
      updateTeamHeader();
      startTimer();

      postApi({
        action: "REGISTER_TEAM",
        teamId: currentTeam.id,
        teamName: currentTeam.name,
        badge: currentTeam.badge
      });

      fetchMissions();
    }

    function updateTeamHeader() {
      document.getElementById("disp-team-name").innerText = currentTeam.name;
      document.getElementById("disp-team-id").innerText = `小隊: ${currentTeam.id}`;
      document.getElementById("disp-badge").innerText = currentTeam.badge;
      document.getElementById("disp-score").innerText = currentScore;
    }

    // ==================== 3. 題目渲染 ====================
    async function fetchMissions() {
      if (!GAS_API_URL) {
        activeMissions = FALLBACK_MISSIONS;
        renderMissions();
        return;
      }

      try {
        const res = await fetch(`${GAS_API_URL}?action=GET_MISSIONS`);
        const data = await res.json();
        activeMissions = (data && data.missions && data.missions.length > 0) ? data.missions : FALLBACK_MISSIONS;
      } catch (e) {
        console.warn("無法取得雲端題庫，切換至備用題庫:", e);
        activeMissions = FALLBACK_MISSIONS;
      }
      renderMissions();
    }

    function renderMissions() {
      const listEl = document.getElementById("mission-list");
      listEl.innerHTML = "";

      let doneCount = 0;
      activeMissions.forEach((m, idx) => {
        const isDone = completedMissionIds.has(m.id);
        const isSkipped = skippedMissionIds.has(m.id);
        if (isDone) doneCount++;

        const card = document.createElement("div");
        card.className = `mission-card ${isDone ? "completed" : ""} ${isSkipped ? "skipped" : ""}`;
        card.id = `card-${m.id}`;

        let actionHtml = "";
        const savedThumb = missionPhotos[m.id];

        if (isDone) {
          if (m.type === "CODE") {
            actionHtml = `
              <div class="completed-proof-box">
                <div style="color: #34d399; font-weight: 800; font-size: 0.95rem;">✓ 本解謎任務已圓滿通關 (+${m.score}分)</div>
              </div>`;
          } else {
            // 已通關拍照題雙按鈕
            actionHtml = `
              <div class="completed-proof-box">
                <div style="color: #34d399; font-weight: 800; font-size: 0.95rem;">✓ 本任務已圓滿通關 (+${m.score}分)</div>
                ${savedThumb ? `<img src="${savedThumb}" class="completed-thumb" id="thumb-${m.id}" alt="存證照片">` : ''}
                
                <div style="margin-top: 10px;">
                  <input type="file" id="file-retake-cam-${m.id}" accept="image/*" capture="environment" style="display: none;" onchange="handleFilePicked('${m.id}', true, 'cam')">
                  <input type="file" id="file-retake-lib-${m.id}" accept="image/*" style="display: none;" onchange="handleFilePicked('${m.id}', true, 'lib')">
                  
                  <div class="preview-container" id="prev-wrap-retake-${m.id}">
                    <img id="prev-img-retake-${m.id}">
