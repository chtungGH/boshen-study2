          } else if (m.type === "PHOTO") {
            actionHtml = `
              <div class="action-box">
                <input type="file" id="file-cam-${m.id}" accept="image/*" capture="environment" style="display: none;" onchange="handleFilePicked('${m.id}', false, 'cam')">
