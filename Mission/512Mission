    // ==================== 放棄與恢復任務 ====================
    function skipMission(mId, mTitle) {
      if (confirm(`確定要戰略放棄「${mTitle}」嗎？\n（放棄後隨時可以點選『恢復挑戰』重新挑戰）`)) {
        skippedMissionIds.add(mId);
        localStorage.setItem("skipped_missions", JSON.stringify(Array.from(skippedMissionIds)));
        renderMissions();
      }
    }

    function resumeMission(mId) {
      skippedMissionIds.delete(mId);
      localStorage.setItem("skipped_missions", JSON.stringify(Array.from(skippedMissionIds)));
      renderMissions();
    }

    // ==================== 4. QR Code 生成與掃描 ====================
    function showMyQrCode() {
      if (!currentTeam.id) {
        alert("請先完成小隊出發認證！");
        return;
      }

      const modal = document.getElementById("qr-modal");
      modal.style.display = "flex";

      const dispEl = document.getElementById("qrcode-display");
      dispEl.innerHTML = "";

      document.getElementById("qr-team-summary").innerText = `${currentTeam.name} (${currentTeam.id}) ${currentTeam.badge}`;

      const qrText = `AGENT_AUTH:${currentTeam.id}|${currentTeam.name}|${currentTeam.badge}`;

      try {
        if (typeof QRCode !== "undefined") {
          new QRCode(dispEl, {
            text: qrText,
            width: 188,
            height: 188,
            colorDark: "#0f172a",
            colorLight: "#ffffff",
            correctLevel: QRCode.CorrectLevel.M
          });
        } else {
          fallbackRenderQr(dispEl, qrText);
        }
      } catch (err) {
        console.warn("QRCodeJS 生成異常，切換至備用圖源:", err);
        fallbackRenderQr(dispEl, qrText);
      }
    }

    function fallbackRenderQr(container, text) {
      const encoded = encodeURIComponent(text);
      container.innerHTML = `<img src="https://api.qrserver.com/v1/create-qr-code/?size=188x188&data=${encoded}" alt="特務QR" style="width:188px;height:188px;border-radius:8px;">`;
    }

    function closeQrModal() {
      document.getElementById("qr-modal").style.display = "none";
    }

    function startQrScanner(mId) {
      const readerBox = document.getElementById("qr-reader-box");
      readerBox.style.display = "block";

      if (html5QrScanner) {
        try { html5QrScanner.stop(); } catch(e){}
      }

      html5QrScanner = new Html5Qrcode("qr-reader");
      html5QrScanner.start(
        { facingMode: "environment" },
        { fps: 10, qrbox: { width: 220, height: 220 } },
        (decodedText) => {
          handleQrScanSuccess(mId, decodedText);
        },
        (error) => {}
      ).catch(err => {
        alert("無法啟動相機掃描，請確認瀏覽器相機權限！");
        readerBox.style.display = "none";
      });
    }

    function stopQrScanner() {
      if (html5QrScanner) {
        html5QrScanner.stop().then(() => {
          document.getElementById("qr-reader-box").style.display = "none";
        }).catch(() => {
          document.getElementById("qr-reader-box").style.display = "none";
        });
      } else {
        document.getElementById("qr-reader-box").style.display = "none";
      }
    }

    function handleQrScanSuccess(mId, decodedText) {
      if (!decodedText.startsWith("AGENT_AUTH:")) {
        alert("❌ 此非合法特務條碼，請掃描其他隊伍或大會裁判的特務條碼！");
        return;
      }

      const parts = decodedText.replace("AGENT_AUTH:", "").split("|");
      const allyId = parts[0];
      const allyName = parts[1] || "盟友小隊";
      const allyBadge = parts[2] || "🤝";

      if (allyId === currentTeam.id) {
        alert("❌ 無法與自己小隊結盟！請尋找其他特務小隊或大會裁判！");
        return;
      }

      stopQrScanner();

      // 支援多重結盟與大會救援碼 (HQ 開頭或一般小隊皆可重複結盟)
      matchedCoopTeams[mId] = { id: allyId, name: allyName, badge: allyBadge };
      localStorage.setItem("matched_coop_teams", JSON.stringify(matchedCoopTeams));

      const isHq = allyId.toUpperCase().startsWith("HQ");
      if (isHq) {
        alert(`🎖️ 已連線【大會總部救援指揮官】！請與裁判共同拍下通關合照！`);
      } else {
        alert(`🎉 成功與【${allyName} ${allyBadge}】建立特務連線！請拍下兩隊合體成員合影！`);
      }
      renderMissions();
    }

    function submitCoopMission(mId, score) {
      const matchedAlly = matchedCoopTeams[mId];
      if (!matchedAlly) {
        alert("請先出示或掃描對方的特務 QR Code（或大會裁判救援碼）完成連線！");
        return;
      }

      const photo = tempPhotos[mId];
      if (!photo) {
        alert("請務必使用【拍所有成員合照】或【選所有成員合照】附上證明！");
        return;
      }

      completeMission(mId, score, `COOP_WITH:${matchedAlly.id}(${matchedAlly.name})`, photo);
    }

    // ==================== 5. 極簡輕量相片壓縮與拍照操作 ====================
    function showProcessing(text = "📸 特務相片加密壓縮中...") {
      const el = document.getElementById("loading-overlay");
      const txt = document.getElementById("loading-title");
      if (txt) txt.innerText = text;
      if (el) el.style.display = "flex";
    }

    function hideProcessing() {
      const el = document.getElementById("loading-overlay");
      if (el) el.style.display = "none";
    }

    // 極簡通用 Canvas 壓縮，徹底避開底層 GC 卡頓與 OOM 崩潰
    function compressSimple(file, maxWidth = 600) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const scale = maxWidth / img.width;
            const targetW = (scale < 1) ? maxWidth : img.width;
            const targetH = (scale < 1) ? Math.round(img.height * scale) : img.height;

            const canvas = document.createElement('canvas');
            canvas.width = targetW;
            canvas.height = targetH;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, targetW, targetH);

            // 輸出輕量 JPEG 縮圖 (品質 0.5 兼顧清晰度與最小體積)
            resolve(canvas.toDataURL('image/jpeg', 0.5));
          };
          img.onerror = () => reject(new Error("影像載入失敗"));
          img.src = e.target.result;
        };
        reader.onerror = () => reject(new Error("檔案讀取失敗"));
        reader.readAsDataURL(file);
      });
    }

    async function handleFilePicked(mId, isRetake = false, source = 'cam') {
      let file = null;
      if (isRetake) {
        const camEl = document.getElementById(`file-retake-cam-${mId}`);
        const libEl = document.getElementById(`file-retake-lib-${mId}`);
        file = (source === 'cam' ? camEl.files[0] : libEl.files[0]) || camEl.files[0] || libEl.files[0];
      } else {
        const camEl = document.getElementById(`file-cam-${mId}`);
        const libEl = document.getElementById(`file-lib-${mId}`);
        file = (source === 'cam' ? camEl.files[0] : libEl.files[0]) || camEl.files[0] || libEl.files[0];
      }
      if (!file) return;

      // 1. 第 1 毫秒立刻顯示全螢幕加密壓縮轉圈提示
      showProcessing("📸 特務相片加密壓縮中...");

      // 2. 讓出 50ms 確保瀏覽器完成渲染 UI 遮罩，不讓畫面看起來死當
      setTimeout(async () => {
        try {
          const base64Thumb = await compressSimple(file, 600);
          tempPhotos[mId] = base64Thumb;

          if (isRetake) {
            const prevWrap = document.getElementById(`prev-wrap-retake-${mId}`);
            const prevImg = document.getElementById(`prev-img-retake-${mId}`);
            prevImg.src = base64Thumb;
            prevWrap.style.display = "block";
            document.getElementById(`retake-btn-row-${mId}`).style.display = "none";
          } else {
            const prevWrap = document.getElementById(`prev-wrap-${mId}`);
            const prevImg = document.getElementById(`prev-img-${mId}`);
            prevImg.src = base64Thumb;
            prevWrap.style.display = "block";
            const pickerRow = document.getElementById(`picker-btn-row-${mId}`);
            if (pickerRow) pickerRow.style.display = "none";
          }
        } catch (err) {
          alert("相片處理失敗，請重新拍攝或選擇相片！");
        } finally {
          hideProcessing();
        }
      }, 50);
    }

    function cancelRetake(mId) {
      document.getElementById(`file-retake-cam-${mId}`).value = "";
      document.getElementById(`file-retake-lib-${mId}`).value = "";
      document.getElementById(`prev-wrap-retake-${mId}`).style.display = "none";
      document.getElementById(`retake-btn-row-${mId}`).style.display = "grid";
    }

    function confirmPhotoRetake(mId) {
      const base64 = tempPhotos[mId];
      if (!base64) return;

      missionPhotos[mId] = base64;
      localStorage.setItem("mission_photos", JSON.stringify(missionPhotos));

      const thumb = document.getElementById(`thumb-${mId}`);
      if (thumb) thumb.src = base64;

      cancelRetake(mId);

      postApi({
        action: "SUBMIT_MISSION",
        teamId: currentTeam.id,
        badge: currentTeam.badge,
        missionId: mId,
        answerText: "PHOTO_RETAKE_UPDATE",
        photoBase64: base64,
        deviceInfo: navigator.userAgent.substring(0, 50)
      });
    }

    function resetPicker(mId) {
      if (document.getElementById(`file-cam-${mId}`)) document.getElementById(`file-cam-${mId}`).value = "";
      if (document.getElementById(`file-lib-${mId}`)) document.getElementById(`file-lib-${mId}`).value = "";
      document.getElementById(`prev-wrap-${mId}`).style.display = "none";
      const pickerRow = document.getElementById(`picker-btn-row-${mId}`);
      if (pickerRow) pickerRow.style.display = "grid";
    }

    function confirmPhotoUpload(mId, score) {
      const base64 = tempPhotos[mId];
      if (!base64) return;
      const confirmBtn = document.getElementById(`btn-confirm-${mId}`);
      confirmBtn.innerText = "⏳ 上傳存證中...";
      confirmBtn.disabled = true;

      completeMission(mId, score, "PHOTO_UPLOAD", base64);
    }

    function verifyCode(mId, correctPasscode, score) {
      const inputEl = document.getElementById(`input-${mId}`);
      const errBanner = document.getElementById(`err-${mId}`);
      const val = inputEl.value.trim();

      if (val.toLowerCase() === String(correctPasscode).toLowerCase() || correctPasscode === "") {
        errBanner.style.display = "none";
        completeMission(mId, score, val, "");
      } else {
        inputEl.classList.add("error");
        errBanner.innerText = "❌ 暗號不正確，再仔細確認一次現場線索！";
        errBanner.style.display = "block";
        setTimeout(() => inputEl.classList.remove("error"), 400);
      }
    }

    function completeMission(mId, score, ansText, photoBase64) {
      const wasAllDoneBefore = (completedMissionIds.size === activeMissions.length);

      completedMissionIds.add(mId);
      skippedMissionIds.delete(mId);
      currentScore += score;
      if (photoBase64) missionPhotos[mId] = photoBase64;

      localStorage.setItem("completed_missions", JSON.stringify(Array.from(completedMissionIds)));
      localStorage.setItem("skipped_missions", JSON.stringify(Array.from(skippedMissionIds)));
      localStorage.setItem("current_score", currentScore);
      localStorage.setItem("mission_photos", JSON.stringify(missionPhotos));

      updateTeamHeader();
      renderMissions();

      postApi({
        action: "SUBMIT_MISSION",
        teamId: currentTeam.id,
        badge: currentTeam.badge,
        missionId: mId,
        answerText: ansText,
        photoBase64: photoBase64,
        deviceInfo: navigator.userAgent.substring(0, 50)
      });

      if (!wasAllDoneBefore && completedMissionIds.size === activeMissions.length && activeMissions.length > 0) {
        triggerGrandFinale();
      }
    }

    // ==================== 6. 煙火特效與動態結業證書 ====================
    function triggerGrandFinale() {
      startConfetti();
      window.scrollTo({ top: 0, behavior: 'smooth' });
      const banner = document.getElementById("all-done-banner");
      banner.style.display = "block";

      setTimeout(() => {
        openCertModal();
      }, 2500);
    }

    function openCertModal() {
      const totalCount = activeMissions.length;
      const doneCount = completedMissionIds.size;
      const isGrandSlam = (doneCount === totalCount && totalCount > 0);

      document.getElementById("cert-modal").style.display = "flex";
      document.getElementById("cert-team-title").innerText = `${currentTeam.name} (${currentTeam.id})`;
      document.getElementById("cert-score").innerText = currentScore;
      document.getElementById("cert-tasks").innerText = `${doneCount} / ${totalCount}`;

      const badgeEl = document.getElementById("cert-badge");
      const titleEl = document.getElementById("cert-title-text");
      const cheerEl = document.getElementById("cert-cheer-text");

      if (isGrandSlam) {
        badgeEl.innerText = "🏆";
        titleEl.innerText = "特務大滿貫榮譽勳章";
        cheerEl.innerText = `太震撼了！全員以頂尖默契突破了全部 ${totalCount} 項極限考驗，榮登特務名人堂！`;
      } else if (doneCount >= Math.ceil(totalCount / 2)) {
        badgeEl.innerText = "🎖️";
        titleEl.innerText = "勇氣特務榮譽證書";
        cheerEl.innerText = `表現超棒！成功完成了 ${doneCount} / ${totalCount} 項挑戰！在有限時間內展現了絕佳的團隊探索精神，你們都是優秀的特務冒險家！`;
      } else {
        badgeEl.innerText = "🌟";
        titleEl.innerText = "探索先鋒榮譽證書";
        cheerEl.innerText = `勇敢邁出每一步！成功解開了 ${doneCount} 項謎題，每一份努力都留下了最熱血的回憶，期待未來更多冒險！`;
      }

      if (startTime) {
        const diffSec = Math.floor((new Date().getTime() - startTime) / 1000);
        const mins = String(Math.floor(diffSec / 60)).padStart(2, '0');
        const secs = String(diffSec % 60).padStart(2, '0');
        document.getElementById("cert-duration").innerText = `${mins}分${secs}秒`;
      }
    }

    function startConfetti() {
      const canvas = document.getElementById("confetti-canvas");
      const ctx = canvas.getContext("2d");
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
      canvas.style.display = "block";

      const particles = [];
      const colors = ["#f59e0b", "#10b981", "#3b82f6", "#ef4444", "#ec4899", "#8b5cf6"];

      for (let i = 0; i < 120; i++) {
        particles.push({
          x: canvas.width / 2,
          y: canvas.height / 2,
          r: Math.random() * 6 + 3,
          color: colors[Math.floor(Math.random() * colors.length)],
          vx: (Math.random() - 0.5) * 16,
          vy: (Math.random() - 0.5) * 16 - 3,
          gravity: 0.25,
          alpha: 1,
          decay: Math.random() * 0.015 + 0.008
        });
      }

      function render() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        let alive = false;
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += p.gravity;
          p.alpha -= p.decay;

          if (p.alpha > 0) {
            alive = true;
            ctx.save();
            ctx.globalAlpha = p.alpha;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        });

        if (alive) {
          requestAnimationFrame(render);
        } else {
          canvas.style.display = "none";
        }
      }
      render();
    }

    function handleCertPhoto(e) {
      const file = e.target.files[0];
      if (!file) return;

      showProcessing("📸 正在製作特務結業大合照...");
      setTimeout(async () => {
        try {
          const b64 = await compressSimple(file, 800);
          document.getElementById("cert-photo-placeholder").style.display = "none";
          const cImg = document.getElementById("cert-img");
          cImg.src = b64;
          cImg.style.display = "block";
          localStorage.setItem("cert_img", b64);
        } catch (err) {
          alert("結業相片處理失敗，請重試！");
        } finally {
          hideProcessing();
        }
      }, 50);
    }

    // ==================== 7. 重置與底層連線 ====================
    function resetLocalProgress() {
      if (confirm("⚠️ 確定要重置本機小隊的所有進度嗎？（這將清空手機端分數、照片並重新註冊小隊，但不會刪除雲端試算表紀錄）")) {
        localStorage.clear();
        location.reload();
      }
    }

    async function setupWakeLock() {
      try {
        if ('wakeLock' in navigator) wakeLock = await navigator.wakeLock.request('screen');
      } catch (err) {}
    }

    function setupVisibilityMonitor() {
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) {
          awayStartTime = new Date().getTime();
          sendHeartbeat("away");
        } else {
          let awaySec = 0;
          if (awayStartTime) {
            awaySec = Math.round((new Date().getTime() - awayStartTime) / 1000);
            awayStartTime = null;
          }
          setupWakeLock();
          sendHeartbeat("resume", awaySec);
        }
      });
    }

    function sendHeartbeat(state, awaySec = 0) {
      postApi({
        action: "HEARTBEAT",
        teamId: currentTeam.id,
        state: state,
        awayDurationSec: awaySec
      });
    }

    function postApi(payload) {
      if (!GAS_API_URL) return;
      fetch(GAS_API_URL, {
        method: "POST",
        mode: "no-cors",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
    }
  </script>
