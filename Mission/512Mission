                      <button class="btn btn-secondary" onclick="cancelRetake('${m.id}')">取消</button>
                      <button class="btn btn-primary" onclick="confirmPhotoRetake('${m.id}')">🚀 確認覆蓋更換</button>
                    </div>
                  </div>

                  <div id="retake-btn-row-${m.id}" class="btn-split-row">
                    <button class="btn btn-secondary" onclick="document.getElementById('file-retake-cam-${m.id}').click()">📸 重新拍照</button>
                    <button class="btn btn-secondary" onclick="document.getElementById('file-retake-lib-${m.id}').click()">🖼️ 重新選圖</button>
